{
  "name": "@recallnet/memracer",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && pnpm build:dashboard && rm -rf dist/dashboard/web-dist dist/dashboard/public && mkdir -p dist/dashboard && cp -R src/dashboard/web-dist dist/dashboard/web-dist && cp -R src/dashboard/public dist/dashboard/public",
    "build:dashboard": "pnpm typecheck:dashboard && vite build --config vite.dashboard.config.ts && node scripts/smoke-dashboard-build.mjs",
    "smoke:dashboard": "node scripts/smoke-dashboard-build.mjs",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "typecheck:dashboard": "tsc -p tsconfig.dashboard.json --noEmit",
    "lint:dashboard-spacing": "node scripts/lint-dashboard-spacing.mjs",
    "test": "pnpm build:dashboard && vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "eval:bare-coder": "tsx scripts/eval-bare-coder.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:effect-adoption": "tsx scripts/eval-effect-adoption.ts",
    "eval:groom-quality-export": "tsx scripts/export-groom-quality.ts",
    "eval:context-cache": "tsx scripts/eval-context-cache.ts",
    "okf:consolidate": "tsx scripts/consolidate-project-memory.ts",
    "seed": "tsx scripts/seed.ts",
    "eval:review-fidelity": "tsx scripts/eval-review-fidelity.ts",
    "eval:fix-chore-over-clarify": "tsx scripts/eval-fix-chore-over-clarify.ts",
    "eval:layer2": "tsx scripts/eval-layer2.ts",
    "marketing:shots": "tsx scripts/generate-marketing-shots.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/space-grotesk": "5.2.8",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "3.22.0",
    "express": "^5.3.0",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "pushmatic": "1.0.1",
    "react": "19.2.7",
    "react-avatar": "^5.0.4",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-tabs": "^6.1.1",
    "react-tooltip": "^6.0.8",
    "remark-gfm": "^4.0.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/api-key": "1.6.23",
    "@electric-sql/pglite": "^0.5.10",
    "@langchain/core": "^1.2.17",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "agentevals": "0.0.7",
    "better-auth": "1.6.23",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "undici@>=8.0.0 <8.10.2": "^8.10.2",
      "@earendil-works/pi-ai": "0.80.6",
      "@earendil-works/pi-agent-core": "0.80.6",
      "@earendil-works/pi-tui": "0.80.6",
      "@assistant-ui/core": "0.2.20",
      "@assistant-ui/store": "0.2.19",
      "@assistant-ui/tap": "0.9.3"
    }
  }
}
